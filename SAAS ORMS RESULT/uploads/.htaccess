# Protect uploads directory
Options -Indexes

<FilesMatch "\.(php|php[3-8]|phtml|phar|pl|py|jsp|asp|aspx|htm|html|shtml|sh|cgi|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow image files only
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
